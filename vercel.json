{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "wedding-invitations-m01.festanovaco.com"
        }
      ],
      "destination": "https://festanovaco.com/invitations-wedding-model-01",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "wedding-invitations-m01.festanovaco.com"
        }
      ],
      "destination": "https://festanovaco.com/invitations-wedding-model-01/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/invitations-wedding-model-01/(.*\\..*)",
      "destination": "/$1"
    },
    {
      "source": "/invitations-wedding-model-01/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
